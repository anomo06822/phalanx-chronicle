<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Scripts\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Scripts\Presentation\BattleUiTheme.cs" Link="Presentation\BattleUiTheme.cs" />
    <Compile Include="..\..\Assets\Scripts\Presentation\RoleLoadoutCatalog.cs" Link="Presentation\RoleLoadoutCatalog.cs" />
    <Compile Include="..\..\Assets\Scripts\UI\BattleHudModels.cs" Link="UI\BattleHudModels.cs" />
    <Compile Include="..\..\Assets\Scripts\Battle\BattleHudModelBuilder.cs" Link="Battle\BattleHudModelBuilder.cs" />
    <Compile Include="..\..\Assets\Scripts\Battle\Effects\BattleActionSequencer.cs" Link="Battle\Effects\BattleActionSequencer.cs" />
    <Compile Include="..\..\Assets\Scripts\Battle\Effects\BattlePresentationProfile.cs" Link="Battle\Effects\BattlePresentationProfile.cs" />
  </ItemGroup>
</Project>
